{
  "default": {
    "paths": ["tests/features/**/*.feature"],
    "import": ["src/config/cucumber.conf.js", "tests/stepDefinitions/*.js"],
    "format": [
      "pretty",
      "json:src/reporters/cucumber-report.json",
      "html:src/reporters/cucumber-report.html"
    ],
    "parallel": 1,
    "dryRun": false,
    "retry": 0,
    "strict": true,
    "worldParameters": {}
  }
}
